# Was hier hineingehoert: Werkzeuge, Doku, Schnittlisten, Lizenz- und
# Quellenangaben, Analyseergebnisse. Alles Kleine und Textbasierte.
#
# Was draussen bleibt: Rohmaterial, Musikdateien und alles, was sich aus
# Schnittliste plus Quellmaterial neu erzeugen laesst.

# --- Rohmaterial ---------------------------------------------------------
# Neue Projekte legen ihre Quellclips unter material/<projekt>/ ab.
# Die Schnittlisten und PROJEKT.md bleiben in <projekt>/ und werden versioniert.
material/

# Sicherheitsnetz fuer Videodateien ausserhalb von material/
*.mp4
*.MP4
*.mov
*.MOV
*.mts
*.MTS
*.mkv
*.MKV
*.avi
*.AVI
*.webm
*.cr3
*.CR3

# --- Musik ---------------------------------------------------------------
# Gross und lizenzrechtlich gebunden. Die Lizenz- und Quellenangaben daneben
# (*.md, *.info.json) sowie die Analysen bleiben versioniert - sie sind der
# eigentliche Wert und ohne sie ist der Schnitt nicht nachvollziehbar.
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
audio/**/*.png

# --- Abgeleitetes --------------------------------------------------------
# Aus Schnittliste und Quellmaterial jederzeit neu erzeugbar.
out/
frames/
segments/
verify/
sheets/

# --- Umgebung ------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.claude/settings.local.json

# --- Windows -------------------------------------------------------------
Thumbs.db
desktop.ini
